generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ResourceCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum ResourceStatus {
  AVAILABLE
  RESERVED
  BORROWED
  UNAVAILABLE
  ARCHIVED
}

enum BorrowRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  COMPLETED
}

enum BorrowingStatus {
  ACTIVE
  RETURNED
  OVERDUE
}

enum NotificationType {
  BORROW_REQUEST
  REQUEST_APPROVED
  REQUEST_REJECTED
  NEW_MESSAGE
  RESERVATION_CONFIRMED
  RETURN_REMINDER
  RESOURCE_OVERDUE
  REVIEW_RECEIVED
  REPORT_UPDATE
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  REJECTED
}

// ============================================================
// USER
// ============================================================

model User {
  id           String @id @default(uuid()) @db.Uuid
  name         String
  email        String @unique
  passwordHash String

  imageUrl String?
  bio      String?
  phone    String?

  role   UserRole   @default(USER)
  status UserStatus @default(ACTIVE)
  suspendReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Resources owned by this user
  resources Resource[] @relation("ResourceOwner")

  // Borrowing requests
  borrowRequests BorrowRequest[] @relation("BorrowRequester")

  // Reservations
  reservations Reservation[]

  // Actual borrowings
  borrowings Borrowing[]

  // Chat
  conversationParticipants ConversationParticipant[]
  messages                 Message[]

  // Notifications
  notifications Notification[]

  // Reviews
  reviewsWritten  Review[] @relation("ReviewAuthor")
  reviewsReceived Review[] @relation("ReviewTarget")

  // Reports
  reportsCreated Report[] @relation("ReportCreator")
  reportsAgainst Report[] @relation("ReportedUser")

  @@index([status])
  @@index([role])
}

// ============================================================
// CATEGORY
// ============================================================

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resources Resource[]
}

// ============================================================
// RESOURCE
// ============================================================

model Resource {
  id String @id @default(uuid()) @db.Uuid

  title       String
  description String

  condition ResourceCondition
  status    ResourceStatus    @default(AVAILABLE)

  location String?
  city     String?

  ownerId    String @db.Uuid
  categoryId String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation("ResourceOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  category Category @relation(fields: [categoryId], references: [id])

  images ResourceImage[]

  borrowRequests BorrowRequest[]
  reservations   Reservation[]
  borrowings     Borrowing[]

  conversations Conversation[]

  reports Report[]

  @@index([ownerId])
  @@index([categoryId])
  @@index([status])
  @@index([city])
  @@index([createdAt])
}

// ============================================================
// RESOURCE IMAGES
// ============================================================

model ResourceImage {
  id String @id @default(uuid()) @db.Uuid

  url String

  resourceId String @db.Uuid

  createdAt DateTime @default(now())

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
}

// ============================================================
// BORROW REQUEST
// ============================================================

model BorrowRequest {
  id String @id @default(uuid()) @db.Uuid

  resourceId  String @db.Uuid
  requesterId String @db.Uuid

  message String?

  startDate DateTime
  endDate   DateTime

  status BorrowRequestStatus @default(PENDING)

  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  requester User @relation("BorrowRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  reservation Reservation?

  @@index([resourceId])
  @@index([requesterId])
  @@index([status])
  @@index([resourceId, startDate, endDate])
}

// ============================================================
// RESERVATION
// ============================================================

model Reservation {
  id String @id @default(uuid()) @db.Uuid

  resourceId String @db.Uuid
  userId     String @db.Uuid

  borrowRequestId String? @unique @db.Uuid

  startDate DateTime
  endDate   DateTime

  status ReservationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  borrowRequest BorrowRequest? @relation(fields: [borrowRequestId], references: [id])

  borrowing Borrowing?

  @@index([resourceId])
  @@index([userId])
  @@index([status])
  @@index([resourceId, startDate, endDate])
}

// ============================================================
// BORROWING
// ============================================================

model Borrowing {
  id String @id @default(uuid()) @db.Uuid

  resourceId String @db.Uuid
  borrowerId String @db.Uuid

  reservationId String? @unique @db.Uuid

  borrowedAt DateTime @default(now())
  dueDate    DateTime

  returnedAt DateTime?

  status BorrowingStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  borrower User @relation(fields: [borrowerId], references: [id], onDelete: Cascade)

  reservation Reservation? @relation(fields: [reservationId], references: [id])

  review Review?

  @@index([resourceId])
  @@index([borrowerId])
  @@index([status])
  @@index([borrowerId, status])
  @@index([dueDate])
}

// ============================================================
// CONVERSATION
// ============================================================

model Conversation {
  id String @id @default(uuid()) @db.Uuid

  // Optional: conversation can be related to a resource
  resourceId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resource Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  participants ConversationParticipant[]
  messages     Message[]

  @@index([resourceId])
}

// ============================================================
// CONVERSATION PARTICIPANT
// ============================================================

model ConversationParticipant {
  id String @id @default(uuid()) @db.Uuid

  conversationId String @db.Uuid
  userId         String @db.Uuid

  joinedAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

// ============================================================
// MESSAGE
// ============================================================

model Message {
  id String @id @default(uuid()) @db.Uuid

  content String

  conversationId String @db.Uuid
  senderId       String @db.Uuid

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// ============================================================
// NOTIFICATION
// ============================================================

model Notification {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  type NotificationType

  title   String
  message String

  isRead Boolean @default(false)

  link String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

// ============================================================
// REVIEW
// ============================================================

model Review {
  id String @id @default(uuid()) @db.Uuid

  reviewerId String @db.Uuid
  revieweeId String @db.Uuid

  borrowingId String @unique @db.Uuid

  rating Int

  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviewer User @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: Cascade)

  reviewee User @relation("ReviewTarget", fields: [revieweeId], references: [id], onDelete: Cascade)

  borrowing Borrowing @relation(fields: [borrowingId], references: [id], onDelete: Cascade)

  @@index([revieweeId])
  @@index([reviewerId])
}

// ============================================================
// REPORT
// ============================================================

model Report {
  id String @id @default(uuid()) @db.Uuid

  reporterId String @db.Uuid

  reportedUserId String? @db.Uuid
  resourceId     String? @db.Uuid

  reason      String
  description String?

  status ReportStatus @default(PENDING)

  adminNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reporter User @relation("ReportCreator", fields: [reporterId], references: [id], onDelete: Cascade)

  reportedUser User? @relation("ReportedUser", fields: [reportedUserId], references: [id])

  resource Resource? @relation(fields: [resourceId], references: [id])

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([resourceId])
  @@index([status])
}
