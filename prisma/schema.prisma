generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  name          String
  email         String     @unique
  passwordHash  String
  imageUrl      String?
  bio           String?
  phone         String?
  location      String?
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  suspendReason String?

  borrowRequests           BorrowRequest[]           @relation("BorrowRequester")
  borrowings               Borrowing[]
  categorySuggestions      CategorySuggestion[]
  conversationParticipants ConversationParticipant[]
  messages                 Message[]
  notifications            Notification[]
  activities               Activity[]
  reportsAgainst           Report[]                  @relation("ReportedUser")
  reportsCreated           Report[]                  @relation("ReportCreator")
  reservations             Reservation[]
  resources                Resource[]                @relation("ResourceOwner")
  reviewsReceived          Review[]                  @relation("ReviewTarget")
  reviewsWritten           Review[]                  @relation("ReviewAuthor")

  ratingsGiven    Rating[] @relation("RatingRater")
  ratingsReceived Rating[] @relation("RatingReceiver")

  @@index([status])
  @@index([role])
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  resources   Resource[]
}

model CategorySuggestion {
  id        String                   @id @default(uuid()) @db.Uuid
  name      String
  status    CategorySuggestionStatus @default(PENDING)
  userId    String                   @db.Uuid
  createdAt DateTime                 @default(now())
  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Resource {
  id             String            @id @default(uuid()) @db.Uuid
  title          String
  description    String
  condition      ResourceCondition
  status         ResourceStatus    @default(AVAILABLE)
  location       String?
  city           String?
  ownerId        String            @db.Uuid
  categoryId     String            @db.Uuid
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  borrowRequests BorrowRequest[]
  borrowings     Borrowing[]
  conversations  Conversation[]
  reports        Report[]
  reservations   Reservation[]
  category       Category          @relation(fields: [categoryId], references: [id])
  owner          User              @relation("ResourceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  images         ResourceImage[]

  @@index([ownerId])
  @@index([categoryId])
  @@index([status])
  @@index([city])
  @@index([createdAt])
}

model ResourceImage {
  id         String   @id @default(uuid()) @db.Uuid
  url        String
  resourceId String   @db.Uuid
  createdAt  DateTime @default(now())
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
}

model BorrowRequest {
  id          String              @id @default(uuid()) @db.Uuid
  resourceId  String              @db.Uuid
  requesterId String              @db.Uuid
  message     String?
  startDate   DateTime
  endDate     DateTime
  status      BorrowRequestStatus @default(PENDING)
  respondedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  requester   User                @relation("BorrowRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  resource    Resource            @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  reservation Reservation?

  @@index([resourceId])
  @@index([requesterId])
  @@index([status])
  @@index([resourceId, startDate, endDate])
}

model Reservation {
  id              String            @id @default(uuid()) @db.Uuid
  resourceId      String            @db.Uuid
  userId          String            @db.Uuid
  borrowRequestId String?           @unique @db.Uuid
  startDate       DateTime
  endDate         DateTime
  status          ReservationStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  borrowing       Borrowing?
  borrowRequest   BorrowRequest?    @relation(fields: [borrowRequestId], references: [id])
  resource        Resource          @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@index([userId])
  @@index([status])
  @@index([resourceId, startDate, endDate])
}

model Borrowing {
  id            String          @id @default(uuid()) @db.Uuid
  resourceId    String          @db.Uuid
  borrowerId    String          @db.Uuid
  reservationId String?         @unique @db.Uuid
  borrowedAt    DateTime        @default(now())
  dueDate       DateTime
  returnedAt    DateTime?
  status        BorrowingStatus @default(ACTIVE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  borrower      User            @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  reservation   Reservation?    @relation(fields: [reservationId], references: [id])
  resource      Resource        @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  review        Review?
  rating        Rating?

  @@index([resourceId])
  @@index([borrowerId])
  @@index([status])
  @@index([borrowerId, status])
  @@index([dueDate])
}

model Conversation {
  id           String                    @id @default(uuid()) @db.Uuid
  resourceId   String?                   @db.Uuid
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  resource     Resource?                 @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([resourceId])
}

model ConversationParticipant {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  userId         String       @db.Uuid
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  content        String
  conversationId String       @db.Uuid
  senderId       String       @db.Uuid
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model Review {
  id          String    @id @default(uuid()) @db.Uuid
  reviewerId  String    @db.Uuid
  revieweeId  String    @db.Uuid
  borrowingId String    @unique @db.Uuid
  rating      Int
  comment     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  borrowing   Borrowing @relation(fields: [borrowingId], references: [id], onDelete: Cascade)
  reviewee    User      @relation("ReviewTarget", fields: [revieweeId], references: [id], onDelete: Cascade)
  reviewer    User      @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([revieweeId])
  @@index([reviewerId])
}

model Report {
  id             String       @id @default(uuid()) @db.Uuid
  reporterId     String       @db.Uuid
  reportedUserId String?      @db.Uuid
  resourceId     String?      @db.Uuid
  reason         String
  description    String?
  status         ReportStatus @default(PENDING)
  adminNote      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  reportedUser   User?        @relation("ReportedUser", fields: [reportedUserId], references: [id])
  reporter       User         @relation("ReportCreator", fields: [reporterId], references: [id], onDelete: Cascade)
  resource       Resource?    @relation(fields: [resourceId], references: [id])

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([resourceId])
  @@index([status])
}

model Activity {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  action      String
  entityType  String
  entityId    String
  description String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([entityType, entityId])
}

model Rating {
  id String @id @default(uuid()) @db.Uuid

  // The borrowing that this rating belongs to
  borrowingId String @unique @db.Uuid

  // User who gives the rating
  raterId String @db.Uuid

  // User who receives the rating
  ratedUserId String @db.Uuid

  // 1 - 5 stars
  rating Int

  // Optional written review
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  borrowing Borrowing @relation(fields: [borrowingId], references: [id], onDelete: Cascade)

  rater User @relation("RatingRater", fields: [raterId], references: [id], onDelete: Cascade)

  ratedUser User @relation("RatingReceiver", fields: [ratedUserId], references: [id], onDelete: Cascade)

  @@index([raterId])
  @@index([ratedUserId])
  @@index([createdAt])
}

enum ActivityAction {
  RESOURCE_CREATED
  RESOURCE_UPDATED
  RESOURCE_DELETED

  BORROW_REQUEST_CREATED
  BORROW_REQUEST_APPROVED
  BORROW_REQUEST_REJECTED

  BORROWING_STARTED
  RESOURCE_RETURNED

  REPORT_CREATED
  REPORT_RESOLVED

  USER_SUSPENDED
  USER_REACTIVATED
}

enum ActivityEntityType {
  RESOURCE
  BORROW_REQUEST
  BORROWING
  REPORT
  USER
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ResourceCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum ResourceStatus {
  AVAILABLE
  RESERVED
  BORROWED
  UNAVAILABLE
  ARCHIVED
}

enum BorrowRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  COMPLETED
}

enum BorrowingStatus {
  ACTIVE
  RETURNED
  OVERDUE
}

enum NotificationType {
  BORROW_REQUEST
  REQUEST_APPROVED
  REQUEST_REJECTED
  NEW_MESSAGE
  RESERVATION_CONFIRMED
  RETURN_REMINDER
  RESOURCE_OVERDUE
  REVIEW_RECEIVED
  REPORT_UPDATE
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  REJECTED
}

enum CategorySuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}
